# Copy to .env and fill in. .env is git-ignored — never commit real values.

# --- Model access -----------------------------------------------------------
# Gemini API (simplest: one key, no GCP project needed)
GEMINI_API_KEY=your-api-key-here

# Or use Vertex AI instead by commenting out the key above and setting:
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global

# Which model plays which role. The reviewers run on every article every day,
# so they use the cheaper tier; the writer and the judge do not.
MODEL_AUTHOR=gemini-pro-latest
MODEL_WORKER=gemini-3.7-flash

# --- The site this pipeline writes for --------------------------------------
# Base URL of the automation API. The pipeline calls {SITE_API_URL}/posts,
# /products, /articles and /stats beneath it.
SITE_NAME=Example Site
SITE_API_URL=https://example.com/api/automation
SITE_API_TOKEN=generate-a-long-random-string
# Where readers see the articles, if that is not where the API lives. Optional:
# it lets the gate recognise an absolute link back to your own site as an
# internal one, and puts real URLs in the structured data.
SITE_PUBLIC_URL=https://example.com
SITE_API_TIMEOUT=30
# Turn off only for a site not yet on a real certificate — an IP address with a
# self-signed one. The token then travels without a verified peer at the far
# end, so turn it back on the day the site gets a domain.
SITE_API_VERIFY_TLS=true

# --- What to write ----------------------------------------------------------
CONTENT_LANGUAGE=fa
CONTENT_LANGUAGE_NAME=Persian (Farsi)
CONTENT_DOMAIN=your industry, described in a phrase
CONTENT_AUDIENCE=who the article is for
# The site's commercial point of view, in your own words. A company publication
# is expected to argue for what it sells, and an article with no point of view
# persuades nobody. Leave empty for neutral explanatory writing.
#
# The writer advocates for this, but never against its own sources: a claim the
# fact registry does not support is dropped rather than asserted, and a real
# limitation is named rather than hidden. A reader who follows confident advice
# into the wrong equipment does not come back, and does tell people.
CONTENT_STANCE=
CONTENT_TONE=professional, plain, factual
CONTENT_MIN_WORDS=700
CONTENT_MAX_WORDS=1200

# --- Illustration -----------------------------------------------------------
# The writer describes a lead image and marks where pictures belong; they are
# generated after the draft passes the gate, so a revision never pays twice.
IMAGES_ENABLED=true
IMAGE_MODEL=gemini-3.1-flash-image
IMAGE_MAX_IN_BODY=3
# The look every picture shares, so a site does not end up with a gallery of
# unrelated styles.
IMAGE_STYLE=clean editorial photography, natural daylight, realistic equipment, uncluttered composition, muted professional colour palette

# --- Who is worth believing -------------------------------------------------
# Sources are ranked before a claim is allowed to rest on them: standards
# bodies and universities are recognised anywhere (.gov, .edu and the usual
# hosts, built in), but which manufacturers and which trade publications count
# as authorities depends on what your site writes about, so they are listed
# here. Without them, a datasheet ranks no higher than a blog.
# The values below are an example for a solar and storage site — replace them.
SOURCE_MANUFACTURERS=deye.com,victronenergy.com,byd.com,catl.com,huawei.com,sma.de,fronius.com,growatt.com,solaredge.com,tesla.com,enphase.com,pylontech
SOURCE_PUBLICATIONS=pv-magazine,solarpowerworld,energy-storage.news,pvsyst.com,homerenergy.com,renewableenergyworld,batteryuniversity,pveducation
# Extra entries for the two lists that already have sensible defaults.
SOURCE_STANDARDS=nrel.gov,irena.org
SOURCE_ACADEMIC=
SOURCE_WEAK_DOMAINS=
# Read the page each cited fact points at and look for the passage it quotes.
# This is what stops a model quoting a real page as saying something it never
# said. Costs one request per cited source, once per run.
SOURCE_VERIFY_EVIDENCE=true
SOURCE_FETCH_LIMIT=12
# Past this many days, a trade publication or blog is treated as possibly
# stale and a confident claim resting on it is written as an estimate.
# Standards and manufacturer documentation are exempt — an old datasheet is
# still the datasheet. 0 turns the age check off.
SOURCE_MAX_AGE_DAYS=1095

# --- The fact registry ------------------------------------------------------
# A claim that survived the audit is kept and reused until it expires: cheaper
# every day, and consistent between articles, so two pieces never quote
# different numbers for the same thing. Shelf lives are in days, and they are
# the whole discipline — a fact with no expiry goes wrong silently.
FACT_REGISTRY=true
FACT_TTL_PRICE_DAYS=7
FACT_TTL_AVAILABILITY_DAYS=3
FACT_TTL_SPECIFICATION_DAYS=180
FACT_TTL_STANDARD_DAYS=730
FACT_TTL_GENERAL_DAYS=90
# How many remembered facts one run may be offered. A researcher handed two
# hundred facts reads none of them.
FACT_MAX_REUSED=20

# --- The quality gate -------------------------------------------------------
# A draft ships only when every check passes. Lowering these lowers the bar.
MAX_REVISION_ROUNDS=3
MIN_AVERAGE_SCORE=8.0
MIN_SEO_SCORE=7.0

# --- The measurable half of SEO ---------------------------------------------
# These are counted in code, not scored by a reviewer, so the same draft always
# earns the same verdict. Lengths are in characters, as a search result counts
# them. A draft over a maximum is sent back; under a minimum is reported and
# published anyway.
SEO_TITLE_MAX=60
SEO_TITLE_MIN=25
SEO_DESCRIPTION_MAX=165
SEO_DESCRIPTION_MIN=110
# Shortest alt text that actually describes a picture.
SEO_ALT_MIN=10
# Internal links are checked against the articles, products and categories the
# site reported. List any other path that legitimately exists, comma separated,
# or a real link to it reads as broken and blocks the draft.
SEO_KNOWN_PATHS=/about,/contact
# How many question headings an article needs before it is described to a search
# engine as an FAQ. Two is a section; one is a coincidence.
SEO_MIN_FAQ=2
# JSON-LD built in code from the fact registry and the catalogue, sent with the
# post for the site to embed. Turn off if your site generates its own.
SEO_STRUCTURED_DATA=true

# --- Cost accounting --------------------------------------------------------
# Tokens are counted from the model responses; money is estimated from these
# rates, in dollars per million tokens: prefix:input:output, comma separated.
# A model with no rate here counts as zero, so a run that looks suspiciously
# free usually means a model was added and this line was not.
MODEL_RATES=gemini-3.7-flash:0.30:2.50,gemini-3.5-flash:0.30:2.50,gemini-pro-latest:1.25:10.00,gemini-3:1.25:10.00
IMAGE_PRICE_USD=0.04

# --- Notifications ----------------------------------------------------------
# Talk to @BotFather for the token, then message your bot and read the chat id
# from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Local ------------------------------------------------------------------
DB_PATH=data/pipeline.db
# DRY_RUN=true writes nothing to the site; useful for the first runs.
DRY_RUN=false
