[Unit]
Description=Back up the pipeline database

[Service]
Type=oneshot
User=contentwriter
Group=contentwriter
TimeoutStartSec=600
ExecStart=/usr/local/lib/content-writer/backup.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/content-writer

[Install]
WantedBy=multi-user.target
