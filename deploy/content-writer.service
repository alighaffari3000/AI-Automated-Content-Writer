# One article, once. The timer beside this file decides when.
#
# Installed by deploy/install.sh to /etc/systemd/system/. Run it by hand with
#   sudo systemctl start content-writer.service
# and read what happened with
#   journalctl -u content-writer.service -n 200 --no-pager

[Unit]
Description=Write today's article
Documentation=https://github.com/alighaffari3000/AI-Automated-Content-Writer
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=contentwriter
Group=contentwriter
WorkingDirectory=/opt/content-writer

# The database belongs to the machine, not to the checkout: an update replaces
# everything under /opt and must not touch what the pipeline has learned.
Environment=DB_PATH=/var/lib/content-writer/pipeline.db
# HOME so uv looks for its own files somewhere this user owns, and a cache
# under the private /tmp this service gets.
Environment=HOME=/opt/content-writer
Environment=UV_CACHE_DIR=/tmp/uv-cache

# --no-sync: the environment was built at install time and is never modified by
# a run, which is what lets the code directory stay read-only in practice.
ExecStart=/usr/local/bin/uv run --no-sync python -m app.cli run

# A run is seven model calls and takes a couple of minutes. This ceiling exists
# for the run that hangs on a network that never answers: without it, a stuck
# process would still be holding the timer tomorrow.
TimeoutStartSec=1800

# This runs on a machine that also serves a website, so it gets no more than it
# needs: no new privileges, its own /tmp, read-only system directories, and one
# writable path — the database.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectControlGroups=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/content-writer

[Install]
WantedBy=multi-user.target
