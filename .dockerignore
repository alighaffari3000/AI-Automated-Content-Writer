# The image needs the application and its lockfile, nothing else. Keeping the
# rest out makes builds faster and makes it impossible to bake a local .env or
# a database full of real articles into a layer.
.git
.github
data
logs
tests
deploy
docs
*.md
!README.md
.env
.env.*
.venv
__pycache__
*.pyc
.pytest_cache
.ruff_cache
graphify-out
